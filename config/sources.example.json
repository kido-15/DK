{
  "_시작하기": [
    "이 파일은 서식 견본입니다. 직접 편집하지 말고 아래 마법사를 쓰세요.",
    "",
    "    python3 scripts/setup_sites.py",
    "",
    "마법사가 엑스골프 · 카카오골프예약 · 골팡을 순서대로 안내하고,",
    "브라우저에서 복사한 목록 주소를 받아 구조를 분석해",
    "config/sources.json 을 자동으로 만들어 줍니다.",
    "",
    "한 곳만 다시 설정하려면:  python3 scripts/setup_sites.py xgolf",
    "현재 상태 확인:          python3 scripts/setup_sites.py --status"
  ],

  "_셀렉터가_비어_있는_이유": [
    "세 사이트 모두 공개 API 문서가 없고 화면 구조가 수시로 바뀝니다.",
    "지금 맞는 셀렉터를 적어 두어도 다음 개편 때 깨집니다.",
    "그래서 추측한 값을 넣지 않고, 실제 응답에서 찾아내는 도구를 제공합니다.",
    "",
    "아래 세 항목은 마법사가 채워 넣을 자리이며 enabled 가 false 입니다.",
    "마법사를 돌리면 이 자리가 실제 설정으로 바뀌고 true 가 됩니다."
  ],

  "sources": [
    {
      "id": "xgolf",
      "name": "엑스골프",
      "enabled": false,
      "format": "html",
      "respect_robots": true,
      "request": {
        "url": "",
        "method": "GET",
        "headers": { "Referer": "https://www.xgolf.com/" },
        "delay_seconds": 1.5,
        "pages": { "start": 1, "max": 3, "stop_when_empty": true }
      },
      "list_selector": "",
      "fields": {
        "course_name": { "selector": "" },
        "tee_time": { "selector": "" },
        "green_fee": { "selector": "" },
        "slots": { "selector": "" },
        "booking_url": { "selector": "a", "attr": "href", "prefix": "https://www.xgolf.com" }
      }
    },

    {
      "id": "kakao",
      "name": "카카오골프예약",
      "enabled": false,
      "format": "json",
      "respect_robots": true,
      "request": {
        "url": "",
        "method": "GET",
        "headers": { "Referer": "https://golf.kakao.com/" },
        "delay_seconds": 1.5,
        "pages": { "start": 1, "max": 3, "stop_when_empty": true }
      },
      "records_path": "",
      "fields": {
        "course_name": { "path": "" },
        "tee_time": { "path": "" },
        "green_fee": { "path": "" },
        "slots": { "path": "" },
        "play_date": { "from_request": "date" }
      }
    },

    {
      "id": "golfpang",
      "name": "골팡",
      "enabled": false,
      "format": "html",
      "respect_robots": true,
      "request": {
        "url": "",
        "method": "GET",
        "headers": { "Referer": "https://www.golfpang.com/" },
        "delay_seconds": 1.5,
        "pages": { "start": 1, "max": 3, "stop_when_empty": true }
      },
      "list_selector": "",
      "fields": {
        "course_name": { "selector": "" },
        "tee_time": { "selector": "" },
        "green_fee": { "selector": "" },
        "slots": { "selector": "" },
        "booking_url": { "selector": "a", "attr": "href", "prefix": "https://www.golfpang.com" }
      }
    }
  ],

  "_POST_요청_서식": {
    "_설명": "목록이 POST로 조회되는 사이트라면 request 부분을 이렇게 씁니다",
    "request": {
      "url": "https://사이트/api/search",
      "method": "POST",
      "headers": { "Content-Type": "application/json" },
      "body": { "searchDate": "{date:%Y%m%d}", "pageNo": "{page}" },
      "delay_seconds": 1.5,
      "pages": { "start": 1, "max": 3, "stop_when_empty": true }
    }
  },

  "_URL_치환자": {
    "{date:%Y%m%d}": "20260920",
    "{date:%Y-%m-%d}": "2026-09-20",
    "{date:%Y.%m.%d}": "2026.09.20",
    "{page}": "페이지 번호. pages 설정에 따라 1, 2, 3 ... 으로 바뀐다"
  },

  "_필드_설정_문법": {
    "selector": "HTML 전용. 목록 항목 기준 상대 CSS 선택자 (예: 'td.fee')",
    "path": "JSON 전용. 점으로 구분한 키 경로 (예: 'course.name', 'list.0.price')",
    "attr": "선택자가 가리킨 요소의 속성값을 쓴다 (예: 'href')",
    "regex": "뽑아낸 문자열에서 한 번 더 걸러낸다. 괄호 그룹이 있으면 그 그룹을 쓴다",
    "prefix": "상대 주소 앞에 붙일 기본 주소",
    "replace": "문자열 치환. 예: {\"부터\": \"\"}",
    "const": "고정값",
    "from_request": "요청에 쓴 값을 그대로 쓴다. 'date' 또는 'page'"
  },

  "_크롤링_예절": [
    "delay_seconds 를 1초 이상 두세요 (기본 1.5초). 짧으면 사이트에 부담을 주고 차단됩니다.",
    "respect_robots 는 true 로 두세요. robots.txt 가 막은 주소는 자동으로 건너뜁니다.",
    "로그인이 필요한 페이지는 대상으로 삼지 마세요.",
    "각 사이트 이용약관에서 자동 수집을 금지하는지 먼저 확인하세요."
  ]
}
