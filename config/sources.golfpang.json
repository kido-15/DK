{
  "sources": [
    {
      "id": "golfpang",
      "name": "골팡",
      "enabled": true,
      "format": "html",
      "respect_robots": true,

      "_주의": [
        "www.golfpang.com 만 씁니다. m.golfpang.com 은 robots.txt 가 /m/ 를 막고 있고,",
        "모바일 사이트는 내용 전체가 /m/ 아래에 있어 수집 대상이 아닙니다.",
        "로그인 없이 목록 전체가 보이므로 로그인하지 않습니다. 읽기만 하고 아무것도 제출하지 않습니다."
      ],

      "request": {
        "url": "https://www.golfpang.com/web/round/booking_tblList.do",
        "method": "POST",
        "headers": {
          "X-Requested-With": "XMLHttpRequest",
          "Referer": "https://www.golfpang.com/web/round/booking_list.do",
          "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
        },
        "body": {
          "pageNum": "{page}",
          "rd_date": "{date:%Y-%m-%d}",
          "ampm": "",
          "sector": "",
          "clubname": "",
          "sector2": "",
          "sector3": "",
          "cdOrder": ""
        },
        "delay_seconds": 1.5,
        "retries": 4,
        "max_requests": 400,
        "_stop_when_repeated_주의": [
          "골팡은 마지막 페이지를 넘기면 빈 표를 돌려줍니다. 마지막 페이지를 반복해서",
          "주지 않으므로 stop_when_empty 만으로 끝을 알 수 있습니다.",
          "반대로 골팡 목록은 매물이 실시간으로 드나들어 페이지 경계가 계속 밀립니다.",
          "그래서 서로 다른 페이지가 우연히 같은 내용으로 보일 때가 있고,",
          "stop_when_repeated 를 켜 두면 그때 목록 한가운데서 조용히 멈춥니다.",
          "실제로 2026-09-20 수집이 104페이지 중 48페이지에서 멈춰 절반을 놓쳤습니다.",
          "그래서 이 사이트에서는 끕니다."
        ],
        "pages": {
          "start": 1,
          "max": 120,
          "stop_when_empty": true,
          "stop_when_repeated": false
        }
      },

      "list_selector": "table.type2 tr",
      "fields": {
        "course_name": {"selector": "td:nth-child(5)"},
        "play_date":   {"selector": "td:nth-child(2)"},
        "tee_time":    {"selector": "td:nth-child(3)"},
        "green_fee":   {"selector": "td:nth-child(8) span.price"},
        "hole_info":   {"selector": "td:nth-child(6)"}
      }
    }
  ]
}
